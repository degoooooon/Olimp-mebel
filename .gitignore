node_modules
dist
.cache
.DS_Store
*.log
npm-debug.log*

# Архив темы для заливки в WordPress: собирается из папки темы одной
# командой, а весит семь мегабайт — в истории репозитория ему не место
wp-theme/*.zip

# Собранные стили и скрипты темы WordPress: результат npm run build:theme.
# Как и dist, это не исходник — файлы пересобираются одной командой.
# PHP-файлы темы, когда появятся, лежат рядом и в репозиторий попадут.
wp-theme/*/assets

# Исходные фотографии товаров: рабочий материал, а не часть сайта.
# На витрину идут обработанные файлы из src/img/cards.
photos

# Личные рабочие заметки: договорённости и организационные вопросы.
# Наружу не выносятся. Инженерная часть проекта — в docs/journal.md
docs/journal-private.md

# Справочник по модулям: собирается из комментариев в коде командой
# npm run docs. Как и dist, это результат сборки, а не исходник —
# в репозитории ему делать нечего, публикуется он из CI.
docs-site
