{
  "name": "olimp-mebel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Лендинг мебельного склада «Олимп»",
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "dev:phone": "vite --host",
    "build": "vite build",
    "build:theme": "vite build --mode theme && node build/theme-zip.js",
    "docs": "typedoc",
    "preview": "vite preview",
    "lint": "npm run lint:js && npm run lint:types && npm run lint:css && npm run lint:html && npm run lint:editorconfig",
    "lint:js": "eslint src",
    "lint:types": "tsc -p jsconfig.json",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "lint:html": "linthtml src/index.html src/tovar.html",
    "lint:editorconfig": "editorconfig-checker -exclude \"(node_modules|dist|wp-theme|\\.cache)/\"",
    "lint:baseline": "node tools/baseline-check.mjs"
  },
  "devDependencies": {
    "@linthtml/linthtml": "^0.10.2",
    "@spiriit/vite-plugin-svg-spritemap": "^7.1.0",
    "editorconfig-checker": "^6.1.1",
    "eslint": "^8.57.1",
    "eslint-config-htmlacademy": "^10.0.1",
    "linthtml-config-htmlacademy": "^2.0.0",
    "playwright": "^1.61.1",
    "sass-embedded": "^1.97.3",
    "sharp": "^0.34.5",
    "stylelint": "^16.25.0",
    "stylelint-config-htmlacademy": "^4.4.0",
    "svgo": "^4.0.1",
    "typedoc": "^0.28.20",
    "typescript": "~5.9",
    "vite": "^7.3.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-image-optimizer": "^2.0.3",
    "web-features": "^3.6.0"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.8"
  }
}
